  "private": true,
  "description": "Lädt Store-Texte, Listing-Bilder und optional ein App Bundle über die Play Developer API hoch.",
  "license": "UNLICENSED",
  "main": "publish.js",
  "bin": {
    "play-publish": "publish.js"
  },
